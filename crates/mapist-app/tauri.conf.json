{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mapist",
  "version": "0.1.0",
  "identifier": "io.github.wylho.mapist",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Mapist",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "center": true,
        "backgroundColor": "#eef1ef",
        "create": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Mind mapping",
    "longDescription": "Mapist is a mind-mapping application with a built-in MCP server, derived from Minder."
  },
  "mainBinaryName": "mapist"
}
