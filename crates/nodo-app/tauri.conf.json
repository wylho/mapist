{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodo",
  "version": "0.2.0",
  "identifier": "io.github.wylho.nodo",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd nodo-app/ui && pnpm dev",
    "beforeBuildCommand": "cd nodo-app/ui && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Nodo",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "center": true,
        "backgroundColor": "#eef1ef",
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 33
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Mapas mentais, local-first",
    "longDescription": "Nodo é um aplicativo de mapas mentais local-first, compatível com o formato do Minder, com servidor MCP embutido.",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": [
          "minder"
        ],
        "name": "Mapa mental",
        "description": "Mapa mental (formato do Minder)",
        "role": "Editor",
        "mimeType": "application/x-minder"
      }
    ]
  },
  "mainBinaryName": "nodo"
}
